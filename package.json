{
  "name": "smart-log-analyzer",
  "version": "1.0.0",
  "description": "Production-grade streaming log analyzer CLI",
  "main": "dist/index.js",
  "bin": {
    "log-analyzer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "generate": "ts-node scripts/generateLogs.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "csv-stringify": "^6.4.5",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
